# main's read-only tables after the Mobiclip decoder (0x02082254..0x0208aa00, in .text).
#
# A data spec: the bytes come from the user's ROM at build time (tools/extract_data.py), never
# from the repository. Each line gives a symbols.txt symbol its type; the build checks the ROM
# bytes and relocations against it. The types are the ones the code that reads each table uses.

struct GfxFontEntry {       # include/Main/Gfx/GfxMgr.h
    s32 index;
    s32 mode;
    ptr name;
}

struct SceneEntry {         # include/Main/Sys/Scene.h (SceneEntry with its SceneDesc)
    s32 valid;
    s32 overlay;
    ptr onEnter;
    ptr update;
    ptr draw;
    ptr onExit;
}

struct ShakeEntry {         # include/Main/Sys/GameScene.h
    s32 unk_0;
    s32 value;
}

struct VecFx32 {
    s32 x;
    s32 y;
    s32 z;
}

0x02082254  u8[]              # MoMem_Code1C: Mobiclip: copied to fast memory by MoMem (MO_CODE_1C)
0x020823d4  u8[]              # MoMem_Code00: Mobiclip: MO_CODE_00
0x020826d4  s8[16]            # MoAdpcm_IndexTable: Mobiclip ADPCM index adjustment
0x020826e4  s16[89]           # MoAdpcm_StepTable: Mobiclip ADPCM step sizes
0x02082798  u8[0x60]          # GfxMgr_BgPltt
0x020827f8  GfxFontEntry[9]   # GfxMgr_FontTable: GfxMgr font list
0x02082864  u16[16]           # Pad_DirTable
0x02082884  s32[2]            # Gfx3D_ColorFormatTable: Gfx3D colour-mode formats
0x0208288c  u8[]              # TexObj_Cell3DSetupDL
0x02082898  s32[12]           # Gfx3D_ObjWidthShift: int [][4] rows, written out as words
0x020828c8  s32[12]           # Gfx3D_ObjHeightShift
0x020828f8  u32[2]            # Gfx3D_PrimDLSizes: sizes of the two display lists below
0x02082900  u16[8]            # Gfx3D_EdgeColorTable: edge colour table (G3X_SetEdgeColorTable)
0x02082910  u32[9]            # Gfx3D_PrimDL1: display list 1 (Gfx3D_PrimDLs[1])
0x02082934  u32[9]            # Gfx3D_PrimDL0: display list 0 (Gfx3D_PrimDLs[0])
0x02082958  u16[32]           # Gfx3D_ToonTable
0x02082998  SceneEntry[2]     # Scene_EntryTable
0x020829c8  u16[3]            # SlideDrawScene_FadeColors: SlideCol3
0x020829d0  ShakeEntry[8]     # GameScene_ShakeTable: ShakeTable
0x02082a10  u32[6]            # StageBox_FaceAttrs: BoxFaceAttr
0x02082a28  u32[20]           # data_02082a28
0x02082a78  u32[36]           # StageBox_FaceIdxFlip: BoxFaceIdx
0x02082b08  u32[36]           # StageBox_FaceIdx: BoxFaceIdx
0x02082b98  VecFx32           # data_02082b98
0x02082ba4  u8[0x38]          # EffectPtcl_DLTemplate
0x02082bdc  u16[4]            # EffectPartSet_TexCoordTable
0x02082be4  u32[5]            # StageFlags_InitTable: StageFlagsInit
0x02082bf8  ptr[3]            # LangData_PathTable: Lang path strings (LangData.h)

# Everything after the path table (item tables, the Tbl category data and ranges, the
# ParamKind shapes) keeps the default type: the record layouts differ per category and are not
# all clear from the code yet. Each piece has its own symbol, at the address the .data pointer
# tables (Param_ItemTables, Tbl_Cats, ParamKind_ShapeTable) give it.
default raw
